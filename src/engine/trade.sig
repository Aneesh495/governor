(* trade.sig
 * Trade execution record generated by matching engine.
 *)

signature TRADE =
sig
  type trade = {
    match_id : Types.match_id,
    symbol : Types.symbol_id,
    price : Types.price,
    qty : Types.qty,
    maker_order_id : Types.order_id,
    taker_order_id : Types.order_id,
    maker_client_id : Types.client_id,
    taker_client_id : Types.client_id,
    aggressor_side : Types.side,
    timestamp : Types.timestamp_ns
  }

  val create : {
    match_id : Types.match_id,
    symbol : Types.symbol_id,
    price : Types.price,
    qty : Types.qty,
    maker_order_id : Types.order_id,
    taker_order_id : Types.order_id,
    maker_client_id : Types.client_id,
    taker_client_id : Types.client_id,
    aggressor_side : Types.side,
    timestamp : Types.timestamp_ns
  } -> trade

  val notionalValue : trade -> LargeInt.int
  val toString : trade -> string
end
